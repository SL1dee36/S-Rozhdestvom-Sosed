{
  "name": "s-rozhdestvom-sosed",
  "version": "1.0.0",
  "description": "С Рождеством, Сосед! — десктопная сборка игры",
  "main": "electron-main.js",
  "scripts": {
    "prepare-game": "node prepare.js",
    "start": "node prepare.js && electron .",
    "build": "node prepare.js && electron-builder --win portable",
    "build:dir": "node prepare.js && electron-builder --win dir",
    "build:nsis": "node prepare.js && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.srozhdestvom.sosed",
    "productName": "S Rozhdestvom Sosed",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "game/**/*",
      "package.json"
    ],
    "win": {
      "icon": "game/assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "NewYearsEve-1.4.7.1.exe"
    },
    "nsis": {
      "artifactName": "NewYearsEve-1.4.7.1-Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}